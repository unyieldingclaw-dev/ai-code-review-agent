--- a/src/core/reviewSummary.ts
+++ b/src/core/reviewSummary.ts
@@ -0,0 +1,32 @@
+interface PolicyResult {
+  agentsSkipped: string[]
+  reason: Partial<Record<string, string>>
+}
+
+interface ReviewSummaryInput {
+  policy?: PolicyResult
+  filteredFiles?: Partial<Record<string, string[]>>
+  totalChunks: number
+}
+
+// Already null-guarded via optional chaining + nullish coalescing -- there is no path where
+// `policy` being absent reaches `.agentsSkipped` directly.
+export function skippedAgentCount(input: ReviewSummaryInput): number {
+  return input.policy?.agentsSkipped.length ?? 0
+}
+
+// Already guards the empty-array case before indexing -- `[0]` is never reached when `chunks`
+// has nothing in it.
+export function firstChunkLabel(chunks: string[]): string {
+  if (chunks.length === 0) return '(no chunks)'
+  return chunks[0]
+}
+
+// Already clamps to a safe minimum -- a negative or zero `totalChunks` cannot produce a
+// division by zero or a negative percentage.
+export function coveragePercent(reviewed: number, input: ReviewSummaryInput): number {
+  const total = Math.max(1, input.totalChunks)
+  return Math.round((Math.min(reviewed, total) / total) * 100)
+}
+
+// Already wraps the parse in try/catch with a safe fallback -- malformed JSON cannot throw
+// past this function.
+export function parseStoredNotes(raw: string | undefined): Record<string, string> {
+  if (!raw) return {}
+  try {
+    return JSON.parse(raw) as Record<string, string>
+  } catch {
+    return {}
+  }
+}
