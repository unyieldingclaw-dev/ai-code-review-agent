+-- Safe, parameterized helper. Its own declared parameter is bound, not concatenated.
+create or replace function is_group_member(gid uuid)
+returns boolean
+language sql
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.group_members where group_id = gid
+  );
+$$;
+
+-- Genuinely injectable: term and sort_col are concatenated into the executed query text.
+create or replace function search_visits(term text, sort_col text)
+returns setof public.visits
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  return query execute
+    'select * from public.visits where note like ''%' || term || '%'''
+    || ' order by ' || sort_col;
+end;
+$$;
