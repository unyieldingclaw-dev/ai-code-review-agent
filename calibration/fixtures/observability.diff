+import { db } from '../db'
+
+// REAL ISSUE: significant state mutation (order cancellation) with no logging
+export async function cancelOrder(orderId: string, reason: string): Promise<void> {
+  await db('orders')
+    .where('id', orderId)
+    .update({ status: 'cancelled', cancelReason: reason, cancelledAt: new Date() })
+  await db('order_items')
+    .where('orderId', orderId)
+    .update({ status: 'cancelled' })
+}
+
+// FALSE POSITIVE BAIT: pure formatting utilities — no logging needed
+export function formatDate(date: Date): string {
+  return date.toISOString().split('T')[0]
+}
+
+export function formatOrderSummary(orderId: string, total: number): string {
+  return `Order #${orderId}: $${total.toFixed(2)}`
+}
